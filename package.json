{
  "name": "vue-slim-tables",
  "version": "0.3.12",
  "type": "module",
  "main": "./dist/vst.cjs.js",
  "module": "./dist/vst.es.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "lint": "npx @biomejs/biome check ./src --write",
    "test": "vitest",
    "coverage": "vitest run --coverage"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vst.es.js",
      "require": "./dist/vst.cjs.js"
    },
    "./stylesheets": "./dist/vue-slim-tables.css",
    "./styles": "./dist/vue-slim-tables.css",
    "./src/index": "./src/index.ts",
    "./filterable": "./src/ts/use/filterable"
  },
  "keywords": [
    "vue",
    "table"
  ],
  "homepage": "https://github.com/flafla/vue-slim-table",
  "repository": {
    "url": "https://github.com/flafla/vue-slim-table",
    "type": "git"
  },
  "author": "fLa <flatra66@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.0.11",
    "sass": "^1.97.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.16",
    "vue-tsc": "^3.1.8"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  }
}
